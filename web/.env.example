# Copy to web/server/.env for local development. Never commit a real .env.

# --- Server ---
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# --- Database (server-side only) ---
DATABASE_URL=postgresql://localhost:5432/ramrattan_web_dev

# --- Session (server-side only) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-random-64-char-hex-string

# --- Email (magic link) ---
# EMAIL_PROVIDER=console is the documented local/development mechanism: the
# magic link is written to the server log instead of being emailed. Set to
# "smtp" and supply SMTP_* to enable real delivery once a provider is
# configured (any standard SMTP provider - e.g. Postmark, SendGrid, SES -
# works via nodemailer's SMTP transport).
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Ramrattan AI Editorial Studio <no-reply@example.com>

# --- OpenAI (server-side only, never exposed to the browser) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
